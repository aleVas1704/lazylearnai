# Copiar como .env SOLO para desarrollo local. NO subir .env a Git.
# Usar la cadena pooled de Neon para consultas web.
DATABASE_URL=
# Solo si alguna migracion precisa conexion directa.
DATABASE_URL_DIRECT=

# Demo con datos ficticios: generar con secrets.token_urlsafe(32), nunca usar el carnet.
STUDENT_ID_HMAC_KEY=
# Solo localhost HTTP. Dejar 0 en producción; Vercel siempre exige cookie Secure.
STUDENT_ALLOW_LOCAL_HTTP=0

# Tutor IA. Configurar solo en el servidor.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
