"""Tutor guiado: publica avances comprobables, mensajes y señales de actividad.

Para el MVP de fracciones, las reglas matemáticas verifican cada paso. Las
señales de pegado/cambio de pestaña son solo actividad, NUNCA prueba de fraude.
"""

from uuid import UUID, uuid4

import psycopg
from psycopg.rows import dict_row

from backend.core.config import database_url
from backend.modules.guided_math import rules
from backend.modules.student_task_chat.repository import TASK_SQL


class NotStarted(Exception):
    pass


class TooManyMessages(Exception):
    pass


class InvalidMessage(Exception):
    pass


def _url() -> str:
    url = database_url()
    if not url:
        raise psycopg.OperationalError("DATABASE_URL no configurado")
    return url


def is_guided_task(user_id: int, task_id: int) -> bool:
    with psycopg.connect(_url(), connect_timeout=5) as db:
        return db.execute(
            """SELECT EXISTS (
                SELECT 1 FROM public.ll_teacher_task_plans AS plan
                JOIN public.tarea AS task ON task.id = plan.task_id
                WHERE plan.task_id = %s
                  AND EXISTS (
                    SELECT 1 FROM public.ll_user_estudiante AS link
                    JOIN public.inscritos AS ins ON ins.id_estudiante = link.estudiante_id
                    WHERE link.user_id = %s
                      AND (ins.curso, ins.paralelo, ins.gestion)
                          = (task.curso, task.paralelo, task.gestion)
                  )
             )""",
            (task_id, user_id),
        ).fetchone()[0]


def _task_and_plan(cursor: psycopg.Cursor, user_id: int, task_id: int) -> dict | None:
    cursor.execute(TASK_SQL, (user_id, task_id))
    task = cursor.fetchone()
    if not task:
        return None
    cursor.execute(
        "SELECT exercises FROM public.ll_teacher_task_plans WHERE task_id = %s", (task_id,)
    )
    plan = cursor.fetchone()
    if not plan:
        return None
    return {"task": task, "exercises": rules.validate_exercises(plan["exercises"])}


def start_task(user_id: int, task_id: int) -> None:
    with (
        psycopg.connect(_url(), connect_timeout=5, row_factory=dict_row) as db,
        db.cursor() as cursor,
    ):
        data = _task_and_plan(cursor, user_id, task_id)
        if data is None:
            raise InvalidMessage("La tarea no pertenece a este estudiante")
        cursor.execute(
            """INSERT INTO public.ll_task_conversations (id, user_id, task_id)
               VALUES (%s, %s, %s) ON CONFLICT (user_id, task_id) DO NOTHING""",
            (uuid4(), user_id, task_id),
        )
        cursor.execute(
            """SELECT id FROM public.ll_task_conversations
               WHERE user_id = %s AND task_id = %s FOR UPDATE""",
            (user_id, task_id),
        )
        conversation_id = cursor.fetchone()["id"]
        cursor.execute(
            """INSERT INTO public.ll_tutor_progress (conversation_id)
               VALUES (%s) ON CONFLICT DO NOTHING""",
            (conversation_id,),
        )
        cursor.execute(
            """INSERT INTO public.ll_task_messages
                 (id, conversation_id, role, message_kind, status, content)
               VALUES (%s, %s, 'assistant', 'initial', 'complete', %s)
               ON CONFLICT DO NOTHING""",
            (uuid4(), conversation_id, rules.first_prompt(data["exercises"][0], 1)),
        )
        cursor.execute(
            """UPDATE public.ll_task_conversations
               SET initial_status = 'ready', updated_at = now()
               WHERE id = %s""",
            (conversation_id,),
        )


def send_message(user_id: int, task_id: int, request_id: UUID, raw: str) -> None:
    message = " ".join(raw.split()).strip()
    if not message or len(message) > 1200:
        raise InvalidMessage("Tu respuesta debe tener entre 1 y 1200 caracteres")
    with (
        psycopg.connect(_url(), connect_timeout=5, row_factory=dict_row) as db,
        db.cursor() as cursor,
    ):
        data = _task_and_plan(cursor, user_id, task_id)
        if data is None:
            raise InvalidMessage("No tienes acceso a la tarea")
        cursor.execute(
            """SELECT id FROM public.ll_task_conversations
               WHERE user_id = %s AND task_id = %s FOR UPDATE""",
            (user_id, task_id),
        )
        conversation = cursor.fetchone()
        if conversation is None:
            raise NotStarted()
        cid = conversation["id"]
        cursor.execute(
            """SELECT content FROM public.ll_task_messages
               WHERE conversation_id = %s AND client_request_id = %s""",
            (cid, request_id),
        )
        existing = cursor.fetchone()
        if existing:
            if existing["content"] != message:
                raise InvalidMessage("Identificador de solicitud reutilizado")
            return
        cursor.execute(
            """SELECT count(*) AS n FROM public.ll_task_messages
               WHERE conversation_id = %s AND role = 'student'
                 AND created_at > now() - interval '10 minutes'""",
            (cid,),
        )
        if cursor.fetchone()["n"] >= 20:
            raise TooManyMessages()
        cursor.execute(
            """SELECT exercise_index, stage FROM public.ll_tutor_progress
               WHERE conversation_id = %s FOR UPDATE""",
            (cid,),
        )
        progress = cursor.fetchone()
        if not progress:
            raise NotStarted()
        index = progress["exercise_index"]
        stage = progress["stage"]
        if stage == "done":
            reply, new_stage, finished = (
                "Ya completaste los 10 ejercicios. ¡Felicidades!",
                "done",
                False,
            )
        else:
            ex = data["exercises"][index - 1]
            reply, new_stage, finished = rules.next_step(ex, index, stage, message)
            if finished:
                if index < len(data["exercises"]):
                    index += 1
                    new_stage = "concept"
                    reply += " " + rules.first_prompt(data["exercises"][index - 1], index)
                else:
                    new_stage = "done"
                    reply += " ¡Completaste los 10 ejercicios! Tu docente podrá ver el progreso."
        sid = uuid4()
        cursor.execute(
            """INSERT INTO public.ll_task_messages
                  (id, conversation_id, role, message_kind, status, content, client_request_id)
               VALUES (%s, %s, 'student', 'question', 'answered', %s, %s)""",
            (sid, cid, message, request_id),
        )
        cursor.execute(
            """INSERT INTO public.ll_task_messages
                 (id, conversation_id, role, message_kind, status, content, reply_to_message_id)
               VALUES (%s, %s, 'assistant', 'reply', 'complete', %s, %s)""",
            (uuid4(), cid, reply[:4000], sid),
        )
        cursor.execute(
            """UPDATE public.ll_tutor_progress
               SET exercise_index = %s, stage = %s, last_seen_at = now(),
                   completed_at = CASE WHEN %s = 'done' THEN COALESCE(completed_at, now())
                         ELSE completed_at END
               WHERE conversation_id = %s""",
            (index, new_stage, new_stage, cid),
        )
        cursor.execute(
            "UPDATE public.ll_task_conversations SET updated_at = now() WHERE id = %s", (cid,)
        )
        if rules.asks_for_answer(message):
            cursor.execute(
                """INSERT INTO public.ll_tutor_events
                    (id, conversation_id, kind, exercise_index)
                   VALUES (%s, %s, 'answer_request', %s)""",
                (uuid4(), cid, progress["exercise_index"]),
            )


def progress_for_student(user_id: int, task_id: int) -> dict | None:
    with (
        psycopg.connect(_url(), connect_timeout=5, row_factory=dict_row) as db,
        db.cursor() as cursor,
    ):
        cursor.execute(
            """SELECT p.exercise_index, p.stage, p.completed_at
               FROM public.ll_task_conversations AS c
               JOIN public.ll_tutor_progress AS p ON p.conversation_id = c.id
               WHERE c.user_id = %s AND c.task_id = %s""",
            (user_id, task_id),
        )
        return cursor.fetchone()


def record_activity(user_id: int, task_id: int, kind: str) -> bool:
    if kind not in {"paste", "tab_hidden", "tab_visible"}:
        return False
    with (
        psycopg.connect(_url(), connect_timeout=5, row_factory=dict_row) as db,
        db.cursor() as cursor,
    ):
        # Solo registra eventos de tareas que pertenecen a la matrícula del alumno.
        cursor.execute(TASK_SQL, (user_id, task_id))
        if not cursor.fetchone():
            return False
        cursor.execute(
            """SELECT c.id, p.exercise_index
               FROM public.ll_task_conversations AS c
               JOIN public.ll_tutor_progress AS p ON p.conversation_id = c.id
               WHERE c.user_id = %s AND c.task_id = %s""",
            (user_id, task_id),
        )
        row = cursor.fetchone()
        if not row:
            return False
        cursor.execute(
            """SELECT count(*) AS n FROM public.ll_tutor_events
               WHERE conversation_id = %s AND created_at > now() - interval '1 minute'""",
            (row["id"],),
        )
        if cursor.fetchone()["n"] >= 25:
            return False
        cursor.execute(
            """INSERT INTO public.ll_tutor_events
               (id, conversation_id, kind, exercise_index)
               VALUES (%s, %s, %s, %s)""",
            (uuid4(), row["id"], kind, row["exercise_index"]),
        )
        return True
