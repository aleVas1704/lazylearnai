"""Inspeccion SOLO LECTURA; --apply crea datos ficticios en el modelo oficial.

NO elimina tablas demo ni modifica contrasenas existentes.
Al ejecutar --apply, TODO se confirma y se escribe en una unica transaccion.
"""

import argparse
import getpass
import hashlib
import os
import secrets
from datetime import datetime
from pathlib import Path
from urllib.parse import urlsplit

import psycopg
from psycopg import sql

ROOT = Path(__file__).resolve().parents[1]
MIGRATION = ROOT / "migrations" / "005_official_lazy_learn_bridge.sql"
OFFICIAL_TABLES = (
    "usuario",
    "rol",
    "user_rol",
    "curso",
    "paralelo",
    "estudiante",
    "docente",
    "inscritos",
    "matera",
    "materia_docente",
    "clase_paralelo",
    "tarea",
)
EXTRA_TABLES = (
    "ll_user_estudiante",
    "ll_user_docente",
    "ll_student_sessions",
    "ll_task_conversations",
    "ll_task_messages",
)
MATERIAS = {
    "Matematicas [LL-PRUEBA]": (
        ("Fracciones [LL-PRUEBA]", "Calcula 1/2 + 1/4 y explica el procedimiento."),
        ("Ecuaciones [LL-PRUEBA]", "Resuelve 2x + 4 = 14 paso a paso."),
    ),
    "Lenguaje [LL-PRUEBA]": (
        ("Comprension lectora [LL-PRUEBA]", "Explica la idea principal de un texto breve."),
        ("Tipos de palabras [LL-PRUEBA]", "Escribe tres sustantivos y tres verbos."),
    ),
    "Ciencias Sociales [LL-PRUEBA]": (
        ("Historia [LL-PRUEBA]", "Describe dos acontecimientos relevantes de Bolivia."),
        ("Geografia [LL-PRUEBA]", "Identifica tres regiones geograficas de Bolivia."),
    ),
}


def check_urls() -> str:
    direct = os.environ.get("DATABASE_URL_DIRECT", "")
    pooled = os.environ.get("DATABASE_URL", "")
    if not direct or not pooled:
        raise SystemExit("Se requieren DATABASE_URL y DATABASE_URL_DIRECT en .env")
    direct_host = urlsplit(direct).hostname or ""
    pooled_host = urlsplit(pooled).hostname or ""
    if not direct_host or direct_host != pooled_host.replace("-pooler", ""):
        raise SystemExit(
            "Las URL de Neon no parecen apuntar a la misma rama. Verifica .env antes de continuar."
        )
    return direct


def one(db: psycopg.Connection, statement: str, params: tuple = ()) -> tuple | None:
    rows = db.execute(statement, params).fetchmany(2)
    if len(rows) > 1:
        raise RuntimeError("Se encontraron registros duplicados inesperados; sin cambios.")
    return rows[0] if rows else None


def inspect(db: psycopg.Connection) -> None:
    print("\n=== CATALOGO OFICIAL DE NEON (SOLO LECTURA) ===")
    print("Base:", db.execute("SELECT current_database()").fetchone()[0])
    missing = []
    for table in OFFICIAL_TABLES + EXTRA_TABLES:
        exists = db.execute("SELECT to_regclass(%s)", (f"public.{table}",)).fetchone()[0]
        if not exists:
            if table in OFFICIAL_TABLES:
                missing.append(table)
            print(f"  {table}: no existe")
            continue
        count = db.execute(
            sql.SQL("SELECT COUNT(*) FROM public.{}").format(sql.Identifier(table))
        ).fetchone()[0]
        print(f"  {table}: {count} registros")
    if missing:
        raise RuntimeError("Faltan tablas oficiales: " + ", ".join(missing))
    for table in ("curso", "matera", "docente", "estudiante", "tarea", "usuario"):
        row = db.execute(
            """SELECT column_default, is_identity
               FROM information_schema.columns
               WHERE table_schema = 'public' AND table_name = %s
                 AND column_name = 'id'""",
            (table,),
        ).fetchone()
        print(f"  ID automatico {table}: {bool(row and (row[0] or row[1] == 'YES'))}")
    for name in ("Alex Prueba", "Docente Prueba"):
        match = one(
            db,
            """SELECT id FROM public.usuario
               WHERE lower(regexp_replace(btrim(name), '[[:space:]]+', ' ', 'g'))
                   = lower(%s)""",
            (name,),
        )
        print(f"  Cuenta {name}:", "existe" if match else "no existe")
    print("No se mostraron contrasenas, CI ni informacion personal.")
    print("No se modifico nada.\n")


def ensure_role(db: psycopg.Connection, role: str) -> int:
    row = one(
        db,
        "SELECT id FROM public.rol WHERE lower(btrim(nombre)) = lower(%s)",
        (role,),
    )
    if row is None:
        raise RuntimeError(f"Falta el rol {role} en la base oficial")
    return row[0]


def get_account(db: psycopg.Connection, name: str, role_id: int) -> int | None:
    row = one(
        db,
        """SELECT id FROM public.usuario
           WHERE lower(regexp_replace(btrim(name), '[[:space:]]+', ' ', 'g'))
               = lower(%s)""",
        (name,),
    )
    if row is None:
        return None
    allowed = db.execute(
        "SELECT 1 FROM public.user_rol WHERE user_id = %s AND rol_id = %s",
        (row[0], role_id),
    ).fetchone()
    if not allowed:
        raise RuntimeError(f"{name} existe, pero no tiene el rol previsto")
    return row[0]


def password_hash(password: str) -> str:
    salt = secrets.token_bytes(16)
    iterations = 600_000
    hashed = hashlib.pbkdf2_hmac("sha256", password.encode("utf-8"), salt, iterations)
    return f"pbkdf2_sha256${iterations}${salt.hex()}${hashed.hex()}"


def create_user(db: psycopg.Connection, name: str, role_id: int, password: str) -> int:
    user_id = insert_id(db, "usuario", ("name", "password"), (name, password_hash(password)))
    db.execute(
        "INSERT INTO public.user_rol (user_id, rol_id) VALUES (%s, %s)",
        (user_id, role_id),
    )
    return user_id


def insert_id(db: psycopg.Connection, table: str, columns: tuple[str, ...], values: tuple) -> int:
    """Soporta ID serial/identity o tablas oficiales sin DEFAULT de ID.

    Un bloqueo transaccional de desarrollo evita dos ejecuciones simultaneas
    de este script. No sustituye secuencias para escrituras concurrentes externas.
    """
    definition = db.execute(
        """SELECT column_default, is_identity FROM information_schema.columns
           WHERE table_schema = 'public' AND table_name = %s AND column_name = 'id'""",
        (table,),
    ).fetchone()
    if not definition:
        raise RuntimeError(f"Falta la columna id de {table}")
    if not definition[0] and definition[1] != "YES":
        new_id = db.execute(
            sql.SQL("SELECT COALESCE(MAX(id), 0) + 1 FROM public.{}").format(sql.Identifier(table))
        ).fetchone()[0]
        columns = ("id",) + columns
        values = (new_id,) + values
    query = sql.SQL("INSERT INTO public.{} ({}) VALUES ({}) RETURNING id").format(
        sql.Identifier(table),
        sql.SQL(", ").join(map(sql.Identifier, columns)),
        sql.SQL(", ").join(sql.Placeholder() for _ in columns),
    )
    return db.execute(query, values).fetchone()[0]


def ensure_person(
    db: psycopg.Connection, table: str, name: str, synthetic_ci: str, birth: str
) -> int:
    result = one(
        db,
        sql.SQL("SELECT id, nombre_completo FROM public.{} WHERE ci = %s").format(
            sql.Identifier(table)
        ),
        (synthetic_ci,),
    )
    if result is not None:
        if result[1] != name:
            raise RuntimeError(f"CI ficticio ocupado por otro nombre en {table}")
        return result[0]
    return insert_id(
        db,
        table,
        ("nombre_completo", "fecha_nacimiento", "ci"),
        (name, birth, synthetic_ci),
    )


def ensure_link(db: psycopg.Connection, table: str, person_column: str, uid: int, pid: int):
    existing = one(
        db,
        sql.SQL("SELECT {} FROM public.{} WHERE user_id = %s").format(
            sql.Identifier(person_column), sql.Identifier(table)
        ),
        (uid,),
    )
    if existing:
        if existing[0] != pid:
            raise RuntimeError("El usuario ya esta vinculado a otra ficha academica")
        return
    db.execute(
        sql.SQL("INSERT INTO public.{} (user_id, {}) VALUES (%s, %s)").format(
            sql.Identifier(table), sql.Identifier(person_column)
        ),
        (uid, pid),
    )


def ensure_course(db: psycopg.Connection) -> int:
    name = "3ro de Secundaria [LL-PRUEBA]"
    result = one(
        db,
        "SELECT id FROM public.curso WHERE curso = %s AND nivel_academico::text = %s",
        (name, "Secundaria"),
    )
    if result:
        return result[0]
    return insert_id(db, "curso", ("nivel_academico", "curso"), ("Secundaria", name))


def ensure_subject(db: psycopg.Connection, name: str) -> int:
    row = one(db, "SELECT id FROM public.matera WHERE nombre = %s", (name,))
    if row:
        return row[0]
    return insert_id(db, "matera", ("nombre",), (name,))


def ensure_task(
    db: psycopg.Connection,
    title: str,
    description: str,
    teacher: int,
    subject: int,
    year: int,
    course: int,
    parallel: str,
) -> int:
    row = one(
        db,
        """SELECT id FROM public.tarea
           WHERE titulo = %s AND id_docente = %s AND id_materia = %s
             AND gestion = %s AND curso = %s AND paralelo = %s""",
        (title, teacher, subject, year, course, parallel),
    )
    if row:
        return row[0]
    return insert_id(
        db,
        "tarea",
        ("titulo", "descripcion", "id_docente", "id_materia", "gestion", "curso", "paralelo"),
        (title, description, teacher, subject, year, course, parallel),
    )


def seed(db: psycopg.Connection, new_teacher_password: str | None) -> None:
    # Serializacion exclusiva entre ejecuciones de este script.
    db.execute("SELECT pg_advisory_xact_lock(48121, 20261121)")
    student_role = ensure_role(db, "Estudiante")
    teacher_role = ensure_role(db, "Docente")
    alex_id = get_account(db, "Alex Prueba", student_role)
    if alex_id is None:
        raise RuntimeError("No existe Alex Prueba. No se crean contrasenas para cuentas existentes")

    teacher_id = get_account(db, "Docente Prueba", teacher_role)
    if teacher_id is None:
        if new_teacher_password is None:
            raise RuntimeError("Falta la contrasena de Docente Prueba")
        teacher_id = create_user(db, "Docente Prueba", teacher_role, new_teacher_password)

    estudiante_id = ensure_person(db, "estudiante", "Alex Prueba", "LL-TEST-EST-ALX", "2009-01-01")
    docente_id = ensure_person(db, "docente", "Docente Prueba", "LL-TEST-DOC-001", "1990-01-01")
    ensure_link(db, "ll_user_estudiante", "estudiante_id", alex_id, estudiante_id)
    ensure_link(db, "ll_user_docente", "docente_id", teacher_id, docente_id)

    year = datetime.now().year
    course_id = ensure_course(db)
    parallel = "A-LL-PRUEBA"
    db.execute(
        """INSERT INTO public.paralelo (curso, nombre_paralelo, gestion)
           VALUES (%s, %s, %s) ON CONFLICT DO NOTHING""",
        (course_id, parallel, year),
    )
    db.execute(
        """INSERT INTO public.inscritos (id_estudiante, curso, paralelo, gestion)
           OVERRIDING SYSTEM VALUE VALUES (%s, %s, %s, %s) ON CONFLICT DO NOTHING""",
        (estudiante_id, course_id, parallel, year),
    )
    for name, tasks in MATERIAS.items():
        subject_id = ensure_subject(db, name)
        db.execute(
            """INSERT INTO public.materia_docente (id_docente, id_materia, gestion)
               VALUES (%s, %s, %s) ON CONFLICT DO NOTHING""",
            (docente_id, subject_id, year),
        )
        db.execute(
            """INSERT INTO public.clase_paralelo
               (id_docente, id_materia, gestion, curso, paralelo)
               VALUES (%s, %s, %s, %s, %s) ON CONFLICT DO NOTHING""",
            (docente_id, subject_id, year, course_id, parallel),
        )
        for title, description in tasks:
            ensure_task(db, title, description, docente_id, subject_id, year, course_id, parallel)
    print("Se vinculo Alex Prueba a estudiante y Docente Prueba a docente.")
    print("Se prepararon un curso, un paralelo, tres materias y seis tareas oficiales.")
    print("Todos los nombres academicos llevan [LL-PRUEBA].")
    print("Las tablas student_demo_* no se tocaron.")


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("--apply", action="store_true", help="Escribir datos solo tras confirmar")
    args = parser.parse_args()
    url = check_urls()
    if not args.apply:
        with psycopg.connect(
            url, connect_timeout=10, options="-c default_transaction_read_only=on"
        ) as db:
            inspect(db)
        return

    print("ATENCION: se crearan tablas ll_* y datos ficticios en tablas OFICIALES.")
    print("No modifica usuarios previos ni borra tablas demo; usa una rama Neon de pruebas.")
    print("Se necesita Alex Prueba y rol Estudiante; se creara Docente Prueba si falta.")
    print("Confirma que DATABASE_URL y DATABASE_URL_DIRECT apuntan a Neon de DESARROLLO.")
    if input("Escribe APLICAR CATALOGO OFICIAL para continuar: ").strip() != (
        "APLICAR CATALOGO OFICIAL"
    ):
        raise SystemExit("Cancelado. No se modifico Neon")

    # Solo una consulta previa de lectura: decidir si necesitamos nueva credencial docente.
    with psycopg.connect(
        url, connect_timeout=10, options="-c default_transaction_read_only=on"
    ) as db:
        teacher_role = ensure_role(db, "Docente")
        teacher_exists = get_account(db, "Docente Prueba", teacher_role) is not None

    password = None
    if not teacher_exists:
        password = getpass.getpass("Contrasena NUEVA para Docente Prueba (12+ caracteres): ")
        if not 12 <= len(password) <= 128:
            raise SystemExit("La contrasena debe tener entre 12 y 128 caracteres")
        if getpass.getpass("Repite la contrasena nueva: ") != password:
            raise SystemExit("Las contrasenas no coinciden")

    # El DDL y TODOS los datos son atomicos: si ocurre un error se revierte todo.
    try:
        with (
            psycopg.connect(url, connect_timeout=10, autocommit=True) as db,
            db.transaction(),
        ):
            db.execute(MIGRATION.read_text(encoding="utf-8"))
            seed(db, password)
    except (psycopg.Error, RuntimeError) as error:
        raise SystemExit(
            f"Operacion cancelada y revertida: {type(error).__name__}: {error}"
        ) from None
    print("LISTO. Las consultas web ya pueden usar el esquema oficial tras instalar el parche.")


if __name__ == "__main__":
    main()
